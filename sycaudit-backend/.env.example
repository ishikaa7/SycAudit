# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development

# Postgres — used by the app (async driver)
DATABASE_URL=postgresql+asyncpg://sycaudit:changeme@db:5432/sycaudit
# Same DB, sync driver — used only by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://sycaudit:changeme@db:5432/sycaudit

DB_PASSWORD=changeme

# LLM provider keys
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

JWT_SECRET=change-this-to-a-real-random-secret
